 namespace squish {
 
+inline float ScalarSelect( float condition, float nonnegative, float negative )
+{
+	return condition >= 0.0f ? nonnegative : negative;
+}
+
+inline float ScalarFloor( float value )
+{
+	float integral = static_cast<float>( static_cast<int>( value ) );
+	float previous = integral - 1.0f;
+	return ScalarSelect( value - integral, integral, previous );
+}
+
+inline float ScalarCeil( float value )
+{
+	float lower = ScalarFloor( value );
+	return lower == value ? lower : lower + 1.0f;
+}
+
+inline float ScalarTruncate( float value )
+{
+	return value > 0.0f ? ScalarFloor( value ) : ScalarCeil( value );
+}
